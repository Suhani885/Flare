# --- Database (Neon Postgres) ---
# Create a free project at https://neon.tech, then copy the connection string
# from the dashboard. Use the DIRECT (non-pooled) host — i.e. WITHOUT "-pooler"
# in the hostname. Neon's pooled endpoint runs PgBouncer in transaction mode,
# which breaks `prisma migrate` (advisory locks / prepared statements). The
# Neon serverless driver adapter we use at runtime works fine over the direct
# connection too, so one URL covers both migrations and the running app.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (sign in with Google) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (and https://your-domain.com/api/auth/callback/google in production)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Groq (AI skin/hair analysis) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Resend (password reset emails) ---
# Get a free key at https://resend.com/api-keys — no domain setup needed to
# start: the default RESEND_FROM_EMAIL below works out of the box, but can
# only send to the email address you signed up to Resend with until you
# verify your own sending domain in the Resend dashboard.
# Without this key, reset links are just logged to the server console (and,
# outside production, echoed back in the API response) instead of emailed.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Flare <onboarding@resend.dev>"

# --- Cloudinary (product & profile image uploads) ---
# Get credentials at https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Razorpay (test mode — product purchases + premium subscription) ---
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-test-secret"
# Public key exposed to the client for the Razorpay checkout widget (same as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
