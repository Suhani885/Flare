generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ENTREPRENEUR
  ADMIN
}

enum Tier {
  FREE
  PREMIUM
}

enum Audience {
  WOMEN
  MEN
  UNISEX
}

enum AnalysisType {
  SKIN
  HAIR
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String     @id @default(cuid())
  name               String?
  email              String     @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  role               Role       @default(USER)
  subscriptionTier   Tier       @default(FREE)
  premiumUntil       DateTime?
  audiencePreference Audience?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  products      Product[]      @relation("SellerProducts")
  orders        Order[]
  subscriptions Subscription[]
  posts         Post[]
  comments      Comment[]
  withdrawals   Withdrawal[]
  blogs         Blog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Analysis {
  id         String       @id @default(cuid())
  userId     String
  type       AnalysisType
  answers    Json
  resultJson Json
  tierUsed   Tier         @default(FREE)
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id                  String        @id @default(cuid())
  sellerId            String?
  name                String
  slug                String        @unique
  description         String
  price               Int
  images              String[]
  ingredients         String[]
  benefits            String[]
  category            String
  audience            Audience      @default(UNISEX)
  sustainabilityScore Int?
  isSponsored         Boolean       @default(false)
  status              ProductStatus @default(PENDING)
  stock               Int           @default(0)
  // External-catalog fields: while few entrepreneurs have onboarded yet,
  // admins/AI can surface real third-party products. isExternal products
  // have no checkout — the storefront links out to sourceUrl instead.
  isExternal          Boolean       @default(false)
  sourceUrl           String?
  sourceName          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  seller     User?       @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([status])
  @@index([audience])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  totalAmount       Int
  status            OrderStatus @default(CREATED)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  price     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Subscription {
  id                String      @id @default(cuid())
  userId            String
  plan              Tier        @default(PREMIUM)
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            OrderStatus @default(CREATED)
  startedAt         DateTime    @default(now())
  expiresAt         DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  tags      String[]
  isRemoved Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  isRemoved Boolean  @default(false)
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id          String           @id @default(cuid())
  sellerId    String
  amount      Int
  status      WithdrawalStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  processedAt DateTime?

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Blog {
  id         String   @id @default(cuid())
  authorId   String
  title      String
  slug       String   @unique
  content    String
  coverImage String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
